<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <rect width="600" height="400" rx="24" fill="#FFF8ED" stroke="#E5D4BC" stroke-width="4" />
  <rect x="0" y="0" width="600" height="60" fill="#833AB4" rx="20" />
  <text x="30" y="38" font-family="sans-serif" font-size="18" font-weight="bold" fill="#FFFFFF">Instagram Customer Review</text>

  <!-- User Info -->
  <circle cx="50" cy="110" r="24" fill="#7A1F3D" />
  <text x="50" y="117" font-family="Georgia, serif" font-size="20" font-weight="bold" fill="#FFF8ED" text-anchor="middle">R</text>
  <text x="90" y="108" font-family="sans-serif" font-size="16" font-weight="bold" fill="#2D2020">Rahul Sharma</text>
  <text x="90" y="128" font-family="sans-serif" font-size="12" fill="#806F6F">Verified Buyer • Kolkata</text>

  <!-- Stars -->
  <text x="480" y="115" font-size="18">⭐⭐⭐⭐⭐</text>

  <!-- Speech Bubble -->
  <rect x="30" y="160" width="540" height="200" rx="16" fill="#F8EFE2" stroke="#F3E6D5" stroke-width="2" />
  <text x="50" y="200" font-family="sans-serif" font-size="15" fill="#2D2020" font-style="italic">"The celebration platter was a huge hit at our office meeting. Truffle slices gone in 5 min!"</text>
  <text x="50" y="330" font-family="sans-serif" font-size="12" font-weight="bold" fill="#7A1F3D">❤️ Bakelicious Gourmet Bakery</text>
</svg>