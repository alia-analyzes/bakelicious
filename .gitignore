# ==========================================
# Bakelicious ERP - Git Ignore Rules
# ==========================================

# --- Environment & Sensitive Variables ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
!*.example

# --- Python & Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
backend/lib/
backend/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# --- Node.js & Next.js ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Databases ---
*.db
*.sqlite
*.sqlite3
bakelicious.db
backend/bakelicious.db

# --- Uploads & Temporary Media ---
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/products/
backend/uploads/products/*
!backend/uploads/products/.gitkeep

# --- IDEs & OS Specific ---
.agents/
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*.log
scratch/
