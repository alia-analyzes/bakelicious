# Database configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./bakelicious.db

# JWT Authentication Secret
SECRET_KEY=bakelicious-secret-key-super-secure-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage Provider configuration (local vs supabase)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_KEY=

# Backend & Frontend URLs
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
